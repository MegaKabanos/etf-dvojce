---
import etfs from '../data/etfs.json' with { type: 'json' };
import { formatDateCz } from '../lib/format';

const dateCz = formatDateCz(etfs.as_of);
---

<header class="band">
	<div class="band-in">
		<span class="brand">Dvojče</span>
		<span class="band-meta">Kurzovní lístek dvojčat · data k {dateCz}</span>
	</div>
</header>
