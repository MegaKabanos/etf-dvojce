---
import Base from '../layouts/Base.astro';
import Band from '../components/Band.astro';
import PlanPage from '../components/PlanPage.tsx';
---

<Base
	title="Váš ETF plán — Dvojče"
	description="Plán na míru: kde koupit evropské dvojče amerického ETF, poplatky v korunách po letech a daňový checklist."
	path="/plan"
	noindex
>
	<Band />
	<main class="page">
		<section class="section">
			<h1 class="plan-h1">Váš ETF plán</h1>
			<PlanPage client:load />
		</section>
	</main>
</Base>
