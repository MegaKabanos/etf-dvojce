---
import Base from '../layouts/Base.astro';
import Band from '../components/Band.astro';
import RateTable from '../components/RateTable.tsx';
import FeeCalculator from '../components/FeeCalculator.tsx';
import { AS_OF_CZ, FUND_TICKERS } from '../lib/view';
---

<Base
	title="Dvojče — evropská dvojčata amerických ETF"
	description="Americké ETF z Česka nekoupíte. Najděte evropské dvojče VOO, SPY nebo VTI a spočítejte poplatky v korunách. Zdarma, bez registrace, se zdroji."
	path="/"
>
	<Band />
	<main class="page">
		<section data-hero="zakaz" aria-labelledby="h1-zakaz">
			<h1 id="h1-zakaz">VOO z Česka nekoupíte.<br />Jeho dvojče ano.</h1>
			<p class="hero-sub">
				Americké ETF jsou pro drobné investory v EU od roku 2018 nedostupné. Ťukněte na fond, který znáte, a hned
				uvidíte evropskou alternativu se stejným indexem.
			</p>
		</section>

		<section data-hero="poplatky" aria-labelledby="h1-poplatky">
			<h1 id="h1-poplatky">Kolik vás stojí poplatky?<br />V korunách. Za 20 let.</h1>
			<p class="hero-sub">
				Porovnejte bankovní podílový fond s ETF, které koupíte u běžného brokera. Dva posuvníky, žádná registrace.
			</p>
		</section>

		<section id="lístek" aria-labelledby="lístek-prompt">
			<div class="label-row">
				<b id="lístek-prompt">Který fond jste chtěli koupit?</b>
				<span>{FUND_TICKERS.length} položek</span>
			</div>
			<RateTable client:load />
			<p class="rt-micro">Zdarma, bez registrace. Data k {AS_OF_CZ}.</p>
		</section>

		<section id="kalkulacka" aria-labelledby="h2-kalkulacka">
			<h2 id="h2-kalkulacka">Kolik vám ukrojí poplatky</h2>
			<p class="section-sub">Stejná investice, stejný trh. Rozdíl je jen v tom, kolik si každý rok vezme správce.</p>
			<FeeCalculator client:load />
			<p class="only-poplatky calc-back">
				<a href="#lístek">Nebo najděte dvojče svého fondu ↓</a>
			</p>
		</section>
	</main>
</Base>
