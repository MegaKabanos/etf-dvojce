---
import Base from '../layouts/Base.astro';
import Band from '../components/Band.astro';
import RateTable from '../components/RateTable.tsx';
import FeeCalculator from '../components/FeeCalculator.tsx';
import StickyCta from '../components/StickyCta.tsx';
import Facts from '../components/Facts.astro';
import Comparison from '../components/Comparison.astro';
import PlanPreview from '../components/PlanPreview.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import { AS_OF_CZ, FUND_TICKERS } from '../lib/view';
---

<Base
	title="Dvojče — evropská dvojčata amerických ETF"
	description="Americké ETF z Česka nekoupíte. Najděte evropské dvojče VOO, SPY nebo VTI a spočítejte poplatky v korunách. Zdarma, bez registrace, se zdroji."
	path="/"
>
	<Band />
	<main class="page">
		<section data-hero="zakaz" aria-labelledby="h1-zakaz">
			<h1 id="h1-zakaz">VOO z Česka nekoupíte.<br />Jeho dvojče ano.</h1>
			<p class="hero-sub">
				Americké ETF jsou pro drobné investory v EU od roku 2018 nedostupné. Ťukněte na fond, který znáte, a hned
				uvidíte evropskou alternativu se stejným indexem.
			</p>
		</section>

		<section data-hero="poplatky" aria-labelledby="h1-poplatky">
			<h1 id="h1-poplatky">Kolik vás stojí poplatky?<br />V korunách. Za&nbsp;20&nbsp;let.</h1>
			<p class="hero-sub">
				Bankovní fond vs. ETF. Bez registrace.
			</p>
		</section>

		<section id="lístek" aria-labelledby="lístek-prompt">
			<div class="label-row">
				<b id="lístek-prompt">Který fond jste chtěli koupit?</b>
				<span>{FUND_TICKERS.length} položek</span>
			</div>
			<RateTable client:load />
			<p class="rt-micro">Zdarma, bez registrace. Data k {AS_OF_CZ}.</p>
		</section>

		<section id="kalkulacka" aria-labelledby="h2-kalkulacka">
			<h2 id="h2-kalkulacka" class="calc-h2">Kolik vám ukrojí poplatky</h2>
			<p class="section-sub">Stejná investice, stejný trh. Rozdíl je jen v tom, kolik si každý rok vezme správce.</p>
			<FeeCalculator client:load />
			<p class="only-poplatky calc-back">
				<a href="#lístek">Nebo najděte dvojče svého fondu ↓</a>
			</p>
		</section>
		<Facts />
		<Comparison />
		<PlanPreview />
		<Faq />
	</main>
	<Footer />
	<StickyCta client:load />
</Base>

<script>
	import { track } from '../lib/track';

	const referrerDomain = (() => {
		try {
			return document.referrer ? new URL(document.referrer).hostname : null;
		} catch {
			return null;
		}
	})();
	track('landing_view', { viewport_width: window.innerWidth, referrer_domain: referrerDomain });

	const marks = [25, 50, 75, 100];
	const reached = new Set<number>();
	let scrollFrame = 0;
	const onScroll = () => {
		scrollFrame = 0;
		const max = document.documentElement.scrollHeight - window.innerHeight;
		const pct = max <= 0 ? 100 : (window.scrollY / max) * 100;
		for (const mark of marks) {
			if (pct >= mark && !reached.has(mark)) {
				reached.add(mark);
				track('scroll_depth', { depth: mark });
			}
		}
	};
	window.addEventListener(
		'scroll',
		() => {
			if (!scrollFrame) scrollFrame = requestAnimationFrame(onScroll);
		},
		{ passive: true },
	);

	document.addEventListener('click', (event) => {
		const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('a[target="_blank"]');
		if (!link) return;
		try {
			track('source_clicked', { domain: new URL(link.href).hostname });
		} catch {
			// ignore malformed hrefs
		}
	});

	document.querySelectorAll<HTMLDetailsElement>('details[data-faq]').forEach((details) => {
		details.addEventListener('toggle', () => {
			if (details.open) track('faq_opened', { question_idx: Number(details.dataset.faq) });
		});
	});
</script>
